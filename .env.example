# Copy to .env and fill in. .env is gitignored — keep it that way.
# Never commit a private key. Never paste one into a chat or a screenshot.

# --- deployer ---
# Use a wallet created for this and nothing else.
DEPLOYER_PRIVATE_KEY=0x
DEPLOYER_ADDRESS=0x

# --- network ---
# Base mainnet
RPC_URL=https://mainnet.base.org
# Base Sepolia:  https://sepolia.base.org
# Arc testnet:   https://rpc.testnet.arc.io

# --- constructor arguments ---
# USDC, 6 decimals on every network below.
#   Base mainnet   0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
#   Base Sepolia   0x036CbD53842c5426634e7929541eC2318f3dCF7e
#   Arc testnet    0x3600000000000000000000000000000000000000
# Verify against developers.circle.com before every mainnet deploy.
# This address is immutable once deployed.
USDC_ADDRESS=0x

# On mainnet both of these must be a multisig, not an EOA.
ARBITER_ADDRESS=0x
FEE_RECIPIENT_ADDRESS=0x

# --- verification ---
# etherscan.io API key; Basescan uses the same one.
BASESCAN_API_KEY=
